{
  "name": "savanna-access-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mock": "node contracts/mock/server.js",
    "format": "prettier --write .",
    "test": "node --test pipeline/src/pack/*.test.mjs module/src/**/*.test.ts module/src/member2-a11y.test.ts",
    "build": "tsx build-components.mjs",
    "axe": "node scripts/run-axe.mjs",
    "ui": "pnpm --filter sandbox-career ui",
    "career": "pnpm --filter sandbox-career dev",
    "dev:api": "pnpm --filter @savanna/api dev",
    "openapi": "pnpm --filter @savanna/api openapi:export && pnpm --filter @savanna/sdk generate",
    "pipeline": "pnpm --filter @savanna/pipeline cli"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/express": "^5.0.6"
    }
  }
}